# reparse the string data as categorical data
enc = OneHotEncoder(drop='if_binary')
encoder = enc.fit(X)
#(Pdb) encoder.get_feature_names_out()[456]
#'number_emergency_76'
#(Pdb) encoder.get_feature_names_out()[458]
#'number_inpatient_1'

X_train_transformed = encoder.transform(X_train)
X_test_transformed = encoder.transform(X_test)

# attempt some feature selection
#X_new = SelectKBest(f_classif, k=5).fit_transform(X_transformed, y)



clf = tree.DecisionTreeClassifier(max_depth=3, random_state=42)
clf = clf.fit(X_train_transformed, y_train)

# visualization

plot_tree(
        clf, 
        filled=True, 
        proportion=True, 
        feature_names=encoder.get_feature_names_out(), 
        class_names=True,
        rounded=True,
)
plt.savefig('decision_tree.png', dpi=300)
#plt.show()


# https://scikit-learn.org/stable/auto_examples/tree/plot_unveil_tree_structure.html
threshold = clf.tree_.threshold
feature = clf.tree_.feature

# Decision path
decision_paths = clf.decision_path(X_test_transformed)
# we will reach a leaf when a prediction is done
# apply gives us as the leaf the sample ends up in
leaf_idx = clf.apply(X_test_transformed)

sample_id = 0
# obtain ids of the nodes `sample_id` goes through, i.e., row `sample_id`
node_index = decision_paths.indices[
    decision_paths.indptr[sample_id] : decision_paths.indptr[sample_id + 1]
]
# node_index
# The nodes that sample_id traversed on its way to be predicted
# array([0, 6, 7, 8])
# the last node id need not be a leaf node as the tree may not know how to predict
# this new item?

print("Rules used to predict sample {id}:\n".format(id=sample_id))
for node_id in node_index:
    # continue to the next node if it is a leaf node
    if leaf_idx[sample_id] == node_id:
        continue

    # check if value of the split feature for sample 0 is below threshold
    if X_test_transformed[sample_id, feature[node_id]] <= threshold[node_id]:
        threshold_sign = "<="
    else:
        threshold_sign = ">"

    print(
        "decision node {node} : (X_test[{sample}, {feature}] = {value}) "
        "{inequality} {threshold})".format(
            node=node_id,
            sample=sample_id,
            feature=feature[node_id],
            value=X_test_transformed[sample_id, feature[node_id]],
            inequality=threshold_sign,
            threshold=threshold[node_id],
        )
    )

# visualize decision path
# we want to get access to the underlying graph structure from the graphviz data format
# and then find the nodes above for this sample and color/mark them differently
# https://github.com/pydot/pydot
import pydot
dot_data = tree.export_graphviz(clf, out_file=None,
                     feature_names=encoder.get_feature_names_out(), 
                     #class_names=[],
                     filled=True, rounded=True,
                     special_characters=True)
graph = pydot.graph_from_dot_data(dot_data)[0]

# https://stackoverflow.com/questions/55878247/how-to-display-the-path-of-a-decision-tree-for-test-samples
decision_path = decision_paths[sample_id]
for n, node_value in enumerate(decision_path.toarray()[0]):
    if node_value == 0:
        continue

    node = graph.get_node(str(n))[0]            
    print(node)

    node.set_fillcolor('green')
    labels = node.get_attributes()['label'].split('<br/>')
    for i, label in enumerate(labels):
        if label.startswith('samples = '):
            labels[i] = 'samples = {}'.format(int(label.split('=')[1]) + 1)

    node.set('label', '<br/>'.join(labels))

filename = 'decision_path_tree_sample.png'
graph.write_png(filename)


# prediction stats
train_accuracy = clf.score(X_train_transformed, y_train)
print(f'Train accuracy: {train_accuracy}')

accuracy = clf.score(X_test_transformed, y_test)
print(f'Test accuracy: {accuracy}')

pred_proba = clf.predict_proba(X_test_transformed)

